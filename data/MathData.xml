<entity-facade-xml type="seed">
    <!-- Note: Fundamental enumerations for the math package. Enumerations are finite sets. -->

    <!-- Logical Operator -->
    <moqui.basic.EnumerationType description="Logical Operator" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Conjunction - AND" enumId="OpAnd" enumCode="AND" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Alternative Denial - NAND" enumId="OpNand" enumCode="NAND" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Disjunction - OR" enumId="OpOr" enumCode="OR" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Joint Denial - NOR" enumId="OpNor" enumCode="NOR" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Exclusive Or - XOR" enumId="OpXor" enumCode="XOR" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Negation - NOT" enumId="OpNot" enumCode="NOT" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Biconditional - XNOR" enumId="OpXnor" enumCode="XNOR" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Equality - EQ" enumId="OpEq" enumCode="EQ" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Inequality - NE" enumId="OpNe" enumCode="NE" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Less Than - LT" enumId="OpLt" enumCode="LT" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Less Than or Equal - LE" enumId="OpLe" enumCode="LE" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Greater Than - GT" enumId="OpGt" enumCode="GT" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Greater Than or Equal - GE" enumId="OpGe" enumCode="GE" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Implication - IMPLIES" enumId="OpImplies" enumCode="IMPLIES" enumTypeId="LogicalOperator"/>
    <moqui.basic.Enumeration description="Membership - IN" enumId="OpIn" enumCode="IN" enumTypeId="LogicalOperator"/>

    <!-- Operational purpose of a categorical morphism. This is intentionally independent
         from MorphismType, which describes mathematical properties such as identity,
         endomorphism, monomorphism, or isomorphism. -->
    <moqui.basic.EnumerationType description="Operational Purpose of a Morphism" enumTypeId="MorphismPurpose"/>
    <moqui.basic.Enumeration description="Abstract transition between control states" enumId="MpTransition"
        enumCode="Transition" enumTypeId="MorphismPurpose"/>
    <moqui.basic.Enumeration description="Operation intended to produce an effect in the controlled environment" enumId="MpAction"
        enumCode="Action" enumTypeId="MorphismPurpose"/>
    <moqui.basic.Enumeration description="Active acquisition of ground-truth evidence from the controlled environment" enumId="MpDiagnostic"
        enumCode="Diagnostic" enumTypeId="MorphismPurpose"/>
    <moqui.basic.Enumeration description="Precondition or admissibility check for a morphism or composition" enumId="MpGuard"
        enumCode="Guard" enumTypeId="MorphismPurpose"/>
    <moqui.basic.Enumeration description="Postcondition check against evidence acquired after execution" enumId="MpVerify"
        enumCode="Verify" enumTypeId="MorphismPurpose"/>
    <moqui.basic.Enumeration description="Recovery or compensating operation after a failed or rejected effect" enumId="MpCompensate"
        enumCode="Compensate" enumTypeId="MorphismPurpose"/>
    <moqui.basic.Enumeration description="Classification of evidence into a finite diagnostic or control outcome" enumId="MpClassify"
        enumCode="Classify" enumTypeId="MorphismPurpose"/>

    <!-- ========================================================== -->
    <!-- Standard Morphism Execution Category                      -->
    <!-- ========================================================== -->
    <!--
        This finite category describes how an otherwise abstract Morphism is submitted to an
        execution environment. It does not duplicate a business/agentic plan and it does not add
        another execution-mode enumeration: the execution modes are themselves standard morphisms.

        A concrete plan morphism normally keeps serviceName as the direct Moqui service or MCP tool
        binding. Its parentMorphismId may refer to one of the standard morphisms below; the harness
        interprets that parent as the execution operator and compiles it to the corresponding Moqui
        service-call, service-schedule, or cancel-scheduled-service operation.

        Periodic execution is represented by scheduling plus cancellation. There is deliberately no
        busy-loop morphism: a controlling plan schedules the task and a later morphism cancels it.
        The periodically invoked diagnostic service must still verify that its expected categorical
        object and execution context are current before producing effects.
    -->
    <moqui.math.ct.Category categoryId="MorphismExecution" categoryTypeEnumId="CtSmall"
        categoryName="Morphism Execution"
        description="Finite category of standard operators used to submit, schedule, observe, await, and cancel executable morphisms.">

        <!-- Objects are execution-interface states, not business workflow states. -->
        <objects categoryObjectId="MxInvocationDef" objectTypeEnumId="CotGeneric"
            objectName="Invocation Definition" objectSymbol="Call"
            description="A morphism with a resolved executable binding and runtime context, not yet submitted."/>
        <objects categoryObjectId="MxExecutionHandle" objectTypeEnumId="CotGeneric"
            objectName="Execution Handle" objectSymbol="Handle"
            description="A Future or ScheduledFuture-like handle for an asynchronous or scheduled invocation."/>
        <objects categoryObjectId="MxExecutionResult" objectTypeEnumId="CotGeneric"
            objectName="Execution Result" objectSymbol="Result"
            description="Finite result, messages, errors, and evidence returned by an invocation."/>
        <objects categoryObjectId="MxCancelledExecution" objectTypeEnumId="CotGeneric"
            objectName="Cancelled Execution" objectSymbol="Cancelled"
            description="Terminal representation of a successfully cancelled scheduled execution."/>

        <!-- Identity arrows make the categorical identities explicit in the finite catalog. -->
        <morphisms morphismId="MxIdInvocationDef" morphismTypeEnumId="MtId"
            sourceObjectId="MxInvocationDef" targetObjectId="MxInvocationDef" morphismName="Identity Invocation Definition"
            morphismSymbol="id_Call"/>
        <morphisms morphismId="MxIdExecutionHandle" morphismTypeEnumId="MtId"
            sourceObjectId="MxExecutionHandle" targetObjectId="MxExecutionHandle" morphismName="Identity Execution Handle"
            morphismSymbol="id_Handle"/>
        <morphisms morphismId="MxIdExecutionResult" morphismTypeEnumId="MtId"
            sourceObjectId="MxExecutionResult" targetObjectId="MxExecutionResult" morphismName="Identity Execution Result"
            morphismSymbol="id_Result"/>
        <morphisms morphismId="MxIdCancelledExecution" morphismTypeEnumId="MtId"
            sourceObjectId="MxCancelledExecution" targetObjectId="MxCancelledExecution" morphismName="Identity Cancelled Execution"
            morphismSymbol="id_Cancelled"/>

        <!-- Direct and asynchronous submission operators. -->
        <morphisms morphismId="MxExecuteSync" morphismTypeEnumId="MtGeneral"
            morphismPurposeEnumId="MpAction" sourceObjectId="MxInvocationDef" targetObjectId="MxExecutionResult"
            morphismName="Execute Synchronously" morphismSymbol="sync"
            description="Compile to ec.service.sync().name(target.serviceName).parameters(runtimeContext).call()."/>
        <morphisms morphismId="MxExecuteAsync" morphismTypeEnumId="MtGeneral"
            morphismPurposeEnumId="MpAction" sourceObjectId="MxInvocationDef" targetObjectId="MxExecutionHandle"
            morphismName="Execute Asynchronously" morphismSymbol="async"
            description="Compile to ec.service.async().name(target.serviceName).parameters(runtimeContext).callFuture()."/>
        <morphisms morphismId="MxExecuteDistributed" parentMorphismId="MxExecuteAsync"
            morphismTypeEnumId="MtGeneral" morphismPurposeEnumId="MpAction"
            sourceObjectId="MxInvocationDef" targetObjectId="MxExecutionHandle"
            morphismName="Execute Asynchronously Distributed" morphismSymbol="distribute"
            description="Compile to ec.service.async().name(target.serviceName).parameters(runtimeContext).distribute(true).callFuture(). Parameters must be serializable."/>

        <!-- Native Moqui scheduled-service operators from the service-scheduling framework extension. -->
        <morphisms morphismId="MxScheduleOneShot" morphismTypeEnumId="MtGeneral"
            morphismPurposeEnumId="MpAction" sourceObjectId="MxInvocationDef" targetObjectId="MxExecutionHandle"
            morphismName="Schedule One Shot" morphismSymbol="scheduleOnce"
            description="Compile to service-schedule type one-shot, or ec.service.schedule(taskName).name(target.serviceName).initialDelay(...).call()."/>
        <morphisms morphismId="MxScheduleFixedRate" morphismTypeEnumId="MtGeneral"
            morphismPurposeEnumId="MpAction" sourceObjectId="MxInvocationDef" targetObjectId="MxExecutionHandle"
            morphismName="Schedule At Fixed Rate" morphismSymbol="fixedRate"
            description="Compile to service-schedule type at-fixed-rate using values from the runtime execution context."/>
        <morphisms morphismId="MxScheduleFixedDelay" morphismTypeEnumId="MtGeneral"
            morphismPurposeEnumId="MpAction" sourceObjectId="MxInvocationDef" targetObjectId="MxExecutionHandle"
            morphismName="Schedule With Fixed Delay" morphismSymbol="fixedDelay"
            description="Compile to service-schedule type with-fixed-delay using values from the runtime execution context."/>
        <morphisms morphismId="MxScheduleDistributed" morphismTypeEnumId="MtEndo"
            morphismPurposeEnumId="MpAction" sourceObjectId="MxInvocationDef" targetObjectId="MxInvocationDef"
            morphismName="Mark Schedule Distributed" morphismSymbol="scheduleDistributed"
            description="Execution modifier compiled to distribute(true) for a scheduled call when a distributed scheduled executor is configured."/>

        <!-- Feedback and lifecycle operators. -->
        <morphisms morphismId="MxObserveExecution" morphismTypeEnumId="MtEndo"
            morphismPurposeEnumId="MpDiagnostic" sourceObjectId="MxExecutionHandle" targetObjectId="MxExecutionHandle"
            morphismName="Observe Execution" morphismSymbol="observe"
            description="Acquire active diagnostic evidence such as running, done, cancelled, timeout, messages, and errors without changing the controlled object."/>
        <morphisms morphismId="MxAwaitExecution" morphismTypeEnumId="MtGeneral"
            morphismPurposeEnumId="MpDiagnostic" sourceObjectId="MxExecutionHandle" targetObjectId="MxExecutionResult"
            morphismName="Await Execution Result" morphismSymbol="await"
            description="Wait for a finite execution result subject to the runtime timeout; failure or timeout remains explicit evidence."/>
        <morphisms morphismId="MxCancelScheduled" morphismTypeEnumId="MtGeneral"
            morphismPurposeEnumId="MpCompensate" sourceObjectId="MxExecutionHandle" targetObjectId="MxCancelledExecution"
            morphismName="Cancel Scheduled Execution" morphismSymbol="cancel"
            description="Compile to cancel-scheduled-service or ec.service.schedule(taskName).cancel(...), when requested by the controlling plan or diagnostics."/>

        <!-- A useful ordinary composition; no special apply/combinator composition type is introduced. -->
        <morphisms morphismId="MxExecuteAsyncAwait" morphismTypeEnumId="MtGeneral"
            morphismPurposeEnumId="MpAction" sourceObjectId="MxInvocationDef" targetObjectId="MxExecutionResult"
            morphismName="Execute Asynchronously And Await" morphismSymbol="await_async"
            description="Composite execution operator: submit asynchronously and then await the resulting handle.">
            <composition compositionTypeEnumId="McBinary">
                <components componentMorphismId="MxExecuteAsync" sequenceNum="10"/>
                <components componentMorphismId="MxAwaitExecution" sequenceNum="20"/>
            </composition>
        </morphisms>
    </moqui.math.ct.Category>

    <!-- Math Function -->
    <moqui.basic.EnumerationType description="Mathematical Function" enumTypeId="MathFunction"/>
    <moqui.basic.Enumeration description="Sine Function" enumId="MfSin" enumTypeId="MathFunction"/>
    <moqui.basic.Enumeration description="Cosine Function" enumId="MfCos" enumTypeId="MathFunction"/>
    <moqui.basic.Enumeration description="Exponential Function" enumId="MfExp" enumTypeId="MathFunction"/>
    <moqui.basic.Enumeration description="Natural Logarithm" enumId="MfLog" enumTypeId="MathFunction"/>
    <moqui.basic.Enumeration description="Polynomial" enumId="MfPoly" enumTypeId="MathFunction"/>
    <!-- etc... -->

    <!-- Algebraic Structure Type (Magma, Group, Ring, Field, Module, etc...).
         parentEnumId defines the primary navigation taxonomy only. Algebraic structures may
         satisfy laws inherited through more than one mathematical path; those laws must not
         be inferred solely from this single-parent hierarchy. -->
    <moqui.basic.EnumerationType description="Algebraic Structure Type" enumTypeId="AlgebraicStructureType"/>

    <!-- ========================================================== -->
    <!-- 1. Magma Hierarchy (One Binary Operation)                  -->
    <!-- ========================================================== -->
    <moqui.basic.Enumeration description="Magma: carrier set equipped with a closed binary operation" enumId="AsMagma" enumTypeId="AlgebraicStructureType"/>

    <!-- Associativity -->
    <moqui.basic.Enumeration description="Semigroup: associative magma" enumId="AsSemigroup" parentEnumId="AsMagma" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Monoid: semigroup with a two-sided identity element" enumId="AsMonoid" parentEnumId="AsSemigroup" enumTypeId="AlgebraicStructureType"/>

    <!-- Invertibility / Divisibility -->
    <moqui.basic.Enumeration description="Quasigroup: magma in which every left and right division equation has a unique solution" enumId="AsQuasigroup" parentEnumId="AsMagma" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Loop: quasigroup with a two-sided identity element" enumId="AsLoop" parentEnumId="AsQuasigroup" enumTypeId="AlgebraicStructureType"/>

    <!-- Convergence: Associativity + Identity + Invertibility -->
    <!-- A group is also an associative loop. The primary parent is Monoid because Enumeration
         supports one parent only; this does not remove the mathematically valid Loop relation. -->
    <moqui.basic.Enumeration description="Group: monoid in which every element has a two-sided inverse" enumId="AsGroup" parentEnumId="AsMonoid" enumTypeId="AlgebraicStructureType"/>
    
    <!-- Abelian Extension -->
    <moqui.basic.Enumeration description="Abelian group: group with a commutative operation" enumId="AsAbelianGroup" parentEnumId="AsGroup" enumTypeId="AlgebraicStructureType"/>

    <!-- Concrete Group Implementations -->
    <moqui.basic.Enumeration description="Additive Abelian group of real numbers (R, +)" enumId="AsAdditiveReal" parentEnumId="AsAbelianGroup" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Additive Abelian group of integers (Z, +)" enumId="AsAdditiveInteger" parentEnumId="AsAbelianGroup" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Cyclic Abelian group of integers modulo 3 under addition (Z/3Z, +)" enumId="AsZ3Group" parentEnumId="AsAbelianGroup" enumTypeId="AlgebraicStructureType"/>

    <!-- ========================================================== -->
    <!-- 2. Ring and Field Hierarchy (Two Binary Operations)        -->
    <!-- ========================================================== -->
    <moqui.basic.Enumeration description="Unital ring: additive Abelian group, multiplicative monoid, and distributive laws" enumId="AsRing" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Field: commutative unital ring with 0 != 1 whose nonzero elements form an Abelian group under multiplication" enumId="AsField" parentEnumId="AsRing" enumTypeId="AlgebraicStructureType"/>

    <!-- Concrete Ring/Field Implementations -->
    <moqui.basic.Enumeration description="Ring of Integers" enumId="AsIntegers" parentEnumId="AsRing" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Finite field of integers modulo 5 (Z/5Z)" enumId="AsZ5Field" parentEnumId="AsField" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Field of Rational Numbers" enumId="AsRationals" parentEnumId="AsField" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Field of Real Numbers" enumId="AsReals" parentEnumId="AsField" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Field Z/7Z (Finite Field of Order 7)" enumId="AsZ7Field" parentEnumId="AsField" enumTypeId="AlgebraicStructureType"/>

    <!-- ========================================================== -->
    <!-- 3. Module and Vector Space (Operations over Ring/Field)    -->
    <!-- ========================================================== -->
    <moqui.basic.Enumeration description="Module: additive Abelian group equipped with scalar multiplication over a specified ring" enumId="AsModule" enumTypeId="AlgebraicStructureType"/>
    
    <!-- Vector Space is essentially a Module where the underlying Ring is a Field -->
    <moqui.basic.Enumeration description="Vector space: module whose scalar ring is a specified field" enumId="AsVectorSpace" parentEnumId="AsModule" enumTypeId="AlgebraicStructureType"/>

    <!-- Concrete Vector Spaces -->
    <moqui.basic.Enumeration description="Three-dimensional vector space R^3 over the field R" enumId="AsRn3" optionValue="3" parentEnumId="AsVectorSpace" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Two-dimensional vector space C^2 over the field C" enumId="AsC2" optionValue="2" parentEnumId="AsVectorSpace" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="State space; its mathematical structure is defined by the selected model" enumId="VsStateSpace" enumCode="StateSpace" enumTypeId="AlgebraicStructureType"/>
    
    <!-- Euclidean Spaces -->
    <moqui.basic.Enumeration description="Finite-dimensional real inner-product vector space" enumId="VsEuclideanSpace" enumCode="EuclideanSpace" parentEnumId="AsVectorSpace" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="2D Euclidean Space" enumId="EuclideanSpace2D" optionValue="2" enumCode="Euclidean2DSpace" parentEnumId="VsEuclideanSpace" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="3D Euclidean Space" enumId="EuclideanSpace3D" optionValue="3" enumCode="Euclidean3DSpace" parentEnumId="VsEuclideanSpace" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="Quaternion coordinates represented as the four-dimensional real Euclidean space R^4" enumId="QuaternionEuclideanSpace" optionValue="4" enumCode="EuclideanQuaternionSpace" parentEnumId="VsEuclideanSpace" enumTypeId="AlgebraicStructureType"/>
    <moqui.basic.Enumeration description="N-dimensional real Euclidean space" enumId="EuclideanSpaceND" enumCode="EuclideanNDSpace" parentEnumId="VsEuclideanSpace" enumTypeId="AlgebraicStructureType"/>
    
    <!-- Thermodynamic Space -->
    <moqui.basic.Enumeration description="Thermodynamic state space; dimensionality and constraints are defined by the selected state variables and model" enumId="VsThermodynamicSpace" enumCode="ThermodynamicSpace" parentEnumId="VsStateSpace" enumTypeId="AlgebraicStructureType"/>

    <!-- Vector Space Dimension -->
    <!-- NOTE: Dimension enumeration represents each dimension of a vector space, allowing for flexible handling of multiple dimensions.
            Use EnumGroupMember to group the dimensions for each vector space. The sequenceNum field of the EnumGroupMember entity gives the position or order of each dimension. -->
    <moqui.basic.EnumerationType description="Space Dimension" enumTypeId="SpaceDimension"/>
    <moqui.basic.Enumeration description="X Dimension" enumId="DimX" enumCode="x" enumTypeId="SpaceDimension"/>
    <moqui.basic.Enumeration description="Y Dimension" enumId="DimY" enumCode="y" enumTypeId="SpaceDimension"/>
    <moqui.basic.Enumeration description="Z Dimension" enumId="DimZ" enumCode="z" enumTypeId="SpaceDimension"/>
    <moqui.basic.EnumerationType description="Time Dimension" enumTypeId="TimeDimension"/>
    <moqui.basic.Enumeration description="Time Dimension" enumId="DimTime" enumCode="t" enumTypeId="TimeDimension"/>
    <moqui.basic.EnumerationType description="Thermodynamic Dimension" enumTypeId="ThermodynamicDimension"/>
    <moqui.basic.Enumeration description="Mass" enumId="DimMass" enumCode="M" enumTypeId="ThermodynamicDimension"/>
    <moqui.basic.Enumeration description="Volume Dimension" enumId="DimVolume" enumCode="V" enumTypeId="ThermodynamicDimension"/>
    <moqui.basic.Enumeration description="Pressure Dimension" enumId="DimPressure" enumCode="P" enumTypeId="ThermodynamicDimension"/>
    <moqui.basic.Enumeration description="Temperature Dimension" enumId="DimTemperature" enumCode="T" enumTypeId="ThermodynamicDimension"/>
    <moqui.basic.Enumeration description="Enthalpy Dimension" enumId="DimEnthalpy" enumCode="H" enumTypeId="ThermodynamicDimension"/>
    <moqui.basic.Enumeration description="Entropy Dimension" enumId="DimEntropy" enumCode="S" enumTypeId="ThermodynamicDimension"/>
    <moqui.basic.Enumeration description="Relative Humidity Dimension" enumId="DimRelativeHumidity" enumCode="RH" enumTypeId="ThermodynamicDimension"/>
            
    <!-- 3D Euclidean Space -->
    <moqui.basic.Enumeration description="3D Euclidean Space" enumId="Eng3DEuclideanSpace" enumTypeId="EnumGroup"/>
    <moqui.basic.EnumGroupMember enumId="DimX" enumGroupEnumId="Eng3DEuclideanSpace"/>
    <moqui.basic.EnumGroupMember enumId="DimY" enumGroupEnumId="Eng3DEuclideanSpace"/>
    <moqui.basic.EnumGroupMember enumId="DimZ" enumGroupEnumId="Eng3DEuclideanSpace"/>
    <!-- Space Time -->
    <moqui.basic.Enumeration description="Space Time" enumId="EngSpaceTime" enumTypeId="EnumGroup"/>
    <moqui.basic.EnumGroupMember enumId="DimX" enumGroupEnumId="EngSpaceTime"/>
    <moqui.basic.EnumGroupMember enumId="DimY" enumGroupEnumId="EngSpaceTime"/>
    <moqui.basic.EnumGroupMember enumId="DimZ" enumGroupEnumId="EngSpaceTime"/>
    <moqui.basic.EnumGroupMember enumId="DimTime" enumGroupEnumId="EngSpaceTime"/>
</entity-facade-xml>
